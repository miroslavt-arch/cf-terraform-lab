# ── State: NEVER commit ──────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/

# The provider lock is ignored HERE because this kit is a template: you will
# replace the provider, and our lock file would just be hashes you delete.
#
# In YOUR repo, do the opposite — commit .terraform.lock.hcl. It is how every
# machine and every CI runner gets identical provider versions, and a version
# skew between a laptop and a runner produces plan differences that look
# exactly like drift.
.terraform.lock.hcl
crash.log
crash.*.log

# ── Variable files may carry real ids; only the example is tracked ───────────
*.tfvars
*.tfvars.json
!*.tfvars.example

# ── Plans can embed sensitive values ────────────────────────────────────────
*.tfplan
plan.json
plan.txt

# ── Credentials ─────────────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
*credentials*

# ── Eval artifacts ──────────────────────────────────────────────────────────
evalreport.json
drift.json

# ── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
__pycache__/
.pytest_cache/
